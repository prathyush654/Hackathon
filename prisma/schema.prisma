datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  location    String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Notice {
  id        Int      @id @default(autoincrement())
  content   String
  active    Boolean  @default(true)
  imageUrl  String?
  createdAt DateTime @default(now())
}

model Sponsor {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
}

model Registration {
  id         Int      @id @default(autoincrement())
  teamName   String
  email      String
  university String
  members    String   // Store as JSON string
  createdAt  DateTime @default(now())
}
